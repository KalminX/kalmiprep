FROM node:20-alpine

# Install Chromium and required font/rendering libraries on Alpine
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ttf-freefont \
    font-noto

ENV CHROMIUM_PATH=/usr/bin/chromium-browser
ENV NODE_ENV=development

WORKDIR /app

CMD ["node", "tests/e2e/playwright_blueprint_executor.js"]
