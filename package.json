{
  "name": "kalmiprep",
  "version": "1.0.0",
  "description": "KalmiPrep by Kalmitech - Premium Exam Preparation Platform",
  "scripts": {
    "build:css": "npx tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --minify",
    "watch:css": "npx tailwindcss -i ./static/css/input.css -o ./static/css/styles.css --watch",
    "test:blueprints": "node tests/e2e/blueprint_runner.js",
    "test:blueprints:headed": "node tests/e2e/blueprint_runner.js --headed",
    "test:playwright": "node tests/e2e/playwright_blueprint_executor.js",
    "test:e2e:docker": "docker run --rm --network webproxy -e BASE_URL=http://kalmiprep-app:8000 -v $(pwd):/app kalmiprep-playwright:latest node tests/e2e/playwright_blueprint_executor.js"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "js-yaml": "^5.5.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "htmx.org": "^2.0.4",
    "katex": "^0.16.21",
    "lucide": "^0.479.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.111.1",
    "nerdamer": "^2.0.0"
  }
}
